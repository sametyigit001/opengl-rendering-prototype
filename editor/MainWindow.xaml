<Window x:Class="rendererUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rendererUI"
        mc:Ignorable="d"
        Title="Engine Editor"
        Height="720"
        Width="1280"
        MinHeight="640"
        MinWidth="1000"
        FontFamily="Segoe UI"
        FontSize="12"
        Background="{StaticResource EditorBackground}"
        Foreground="{StaticResource EditorText}">

    <Window.Resources>
        <Geometry x:Key="EntityGlyph">M8,1 L15,4.5 15,11.5 8,15 1,11.5 1,4.5 Z M1,4.5 L8,8 15,4.5 M8,8 V15</Geometry>
        <Geometry x:Key="ModelGlyph">M1,13 L5,4 9,10 12,6 15,13 Z M5,4 L6,13 M12,6 L11,13</Geometry>
        <Geometry x:Key="ModelNodeGlyph">M3,2 V12 H7 M3,5 H9 M9,3 H14 V7 H9 Z M7,10 H12 V14 H7 Z</Geometry>
        <Geometry x:Key="CameraGlyph">M1,4 H10 V13 H1 Z M10,7 L15,4 V13 L10,10 Z</Geometry>
        <Geometry x:Key="LightGlyph">M5,10 C0,6 4,1 8,1 C13,1 16,6 11,10 L10,12 H6 Z M6,15 H10</Geometry>
        <Geometry x:Key="ImportGlyph">M2,9 V14 H14 V9 M8,1 V10 M4,6 L8,10 12,6</Geometry>
        <Geometry x:Key="NewGlyph">M8,2 V14 M2,8 H14</Geometry>
        <Style x:Key="ViewportChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C6CBD2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" CornerRadius="2" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#383D44"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#344F6A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="#95C4F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E4E7EB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LightTypeSelectorStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F0F2F5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="SelectorButton" Focusable="False" Foreground="White"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SelectorBorder" Background="#30353C"
                                                BorderBrush="#565F69" BorderThickness="1" CornerRadius="4">
                                            <Grid Margin="12,0,11,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="White"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1" Data="M0,0 L5,5 L10,0" Width="10" Height="5"
                                                      Stretch="Fill" Stroke="#C8D0D8" StrokeThickness="1.6"
                                                      VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectorBorder" Property="BorderBrush" Value="#89B9EA"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="SelectorBorder" Property="BorderBrush" Value="#74AEEA"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=SelectorButton}"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#30353C" BorderBrush="#74AEEA" BorderThickness="1"
                                        CornerRadius="4" Padding="3" MinWidth="{Binding ActualWidth, ElementName=SelectorButton}">
                                    <ScrollViewer MaxHeight="180" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LightTypeOptionStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F0F2F5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="OptionBorder" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#44576B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#365C80"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="9,7" Background="#292B2F"
                    BorderBrush="#42454A" BorderThickness="0,0,0,1">
                    <WrapPanel VerticalAlignment="Center">
                                                <Button x:Name="CreateEntityButton" Click="CreateEntityButton_Click" Margin="0,0,4,0" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource NewGlyph}" Width="14" Height="14" Stretch="Uniform" Stroke="#C4CFDA" StrokeThickness="1.5"/>
                                <TextBlock Text="New entity" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportAssetButton" Click="onImportAsset_Click" Margin="0,0,4,0" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ImportGlyph}" Width="14" Height="14" Stretch="Uniform" Stroke="#C4CFDA" StrokeThickness="1.5"/>
                                <TextBlock Text="Import…" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="20" Margin="7,0" Background="#44484D"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                            <RadioButton x:Name="SelectModeRadio" GroupName="TransformTool" Style="{StaticResource ViewportChoice}"
                                         AutomationProperties.Name="Select" ToolTip="Select objects" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Data="M3,2 L13,10 L8.4,10.5 L6.5,15 Z" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                                    <TextBlock Text="Select" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="MoveModeRadio" GroupName="TransformTool" Style="{StaticResource ViewportChoice}"
                                         AutomationProperties.Name="Move" ToolTip="Move the current target">
                                <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Data="M8,1 L8,15 M1,8 L15,8 M5,4 L8,1 L11,4 M5,12 L8,15 L11,12 M4,5 L1,8 L4,11 M12,5 L15,8 L12,11" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                                    <TextBlock Text="Move" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RotateModeRadio" GroupName="TransformTool" Style="{StaticResource ViewportChoice}"
                                         AutomationProperties.Name="Rotate" ToolTip="Rotate the current target">
                                <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Data="M13.8,7 A6,6 0 1 0 13,11 M14,2 L14,7 L9,7" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                                    <TextBlock Text="Rotate" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ScaleModeRadio" GroupName="TransformTool" Style="{StaticResource ViewportChoice}"
                                         AutomationProperties.Name="Scale" ToolTip="Scale the current target">
                                <StackPanel Orientation="Horizontal">
                                <Path Width="15" Height="15" Data="M2,9 L7,9 L7,14 L2,14 Z M6,10 L14,2 M9,2 L14,2 L14,7" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                                    <TextBlock Text="Scale" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Margin="0,3,7,3" Width="1" Background="#45494D"/>
                            <TextBlock Text="Pick" Margin="0,0,4,0" Foreground="#AFB3B9" VerticalAlignment="Center"/>
                            <RadioButton x:Name="EntityTargetRadio" Content="Entity" GroupName="TransformTarget"
                                         Style="{StaticResource ViewportChoice}" ToolTip="Pick the owning entity"/>
                            <RadioButton x:Name="ModelTargetRadio" Content="Model" GroupName="TransformTarget"
                                         Style="{StaticResource ViewportChoice}" ToolTip="Pick a whole model" IsChecked="True"/>
                            <RadioButton x:Name="NodeTargetRadio" Content="Node" GroupName="TransformTarget"
                                         Style="{StaticResource ViewportChoice}" ToolTip="Pick an individual model node"/>
                        </StackPanel>
                    </WrapPanel>
            </Border>
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222" MinWidth="182"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="320" MinWidth="275"/>
            </Grid.ColumnDefinitions>

            <!-- Hierarchy -->
            <Border Grid.Column="0"
                    Background="#202225"
                    BorderBrush="#37414D"
                    BorderThickness="0,0,1,0"
                    Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="38" Padding="12,0" Background="#24272B"
                            BorderBrush="#393D42" BorderThickness="0,0,0,1">
                        <TextBlock Text="Hierarchy" Style="{StaticResource PanelHeading}"/>
                    </Border>
                    <TreeView x:Name="HierarchyTree"
                              SelectedItemChanged="HierarchyTree_SelectedItemChanged"
                              PreviewMouseLeftButtonDown="HierarchyTree_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="HierarchyTree_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="HierarchyTree_PreviewMouseLeftButtonUp"
                              PreviewMouseRightButtonDown="HierarchyTree_PreviewMouseRightButtonDown"
                              AllowDrop="True"
                              DragOver="HierarchyTree_DragOver"
                              Drop="HierarchyTree_Drop"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#E8EDF3"
                              FontSize="12"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Resources>
                            <Style TargetType="{x:Type ScrollBar}">
                                <Setter Property="Width" Value="12"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                                            <Grid Background="Transparent" Width="12">
                                                <Track x:Name="PART_Track"
                                                       IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                      Opacity="0"
                                                                      IsTabStop="False"
                                                                      Focusable="False"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                                    <Border x:Name="ThumbBorder"
                                                                            Background="#515861"
                                                                            CornerRadius="6"
                                                                            Margin="2,3"/>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#737D88"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsDragging" Value="True">
                                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#AAB4C0"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                      Opacity="0"
                                                                      IsTabStop="False"
                                                                      Focusable="False"/>
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="{x:Type ToggleButton}">
                                <Setter Property="Content" Value="›"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#AAB4C0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="⌄"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="AllowDrop" Value="True"/>
                                <Setter Property="Padding" Value="3,1"/>
                                <Setter Property="MinHeight" Value="25"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Foreground" Value="#E6E6E6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Path x:Name="KindIcon" Data="{StaticResource EntityGlyph}" Width="13" Height="13"
                                                      Stretch="Uniform" Stroke="#9CB7CE" StrokeThickness="1.3" Margin="1,0,7,0"/>
                                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Tag.Kind, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="Model">
                                                    <Setter TargetName="KindIcon" Property="Data" Value="{StaticResource ModelGlyph}"/>
                                                    <Setter TargetName="KindIcon" Property="Stroke" Value="#B3A4DD"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag.Kind, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="ModelNode">
                                                    <Setter TargetName="KindIcon" Property="Data" Value="{StaticResource ModelNodeGlyph}"/>
                                                    <Setter TargetName="KindIcon" Property="Stroke" Value="#99A3AD"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag.Kind, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="Camera">
                                                    <Setter TargetName="KindIcon" Property="Data" Value="{StaticResource CameraGlyph}"/>
                                                    <Setter TargetName="KindIcon" Property="Stroke" Value="#84BACA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag.Kind, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="Light">
                                                    <Setter TargetName="KindIcon" Property="Data" Value="{StaticResource LightGlyph}"/>
                                                    <Setter TargetName="KindIcon" Property="Stroke" Value="#EAC777"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border x:Name="HeaderBorder"
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        Margin="2,1,3,1"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Stretch">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="Expander"
                                                                      Grid.Column="0"
                                                                      Width="16"
                                                                      Height="19"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                                        <ContentPresenter x:Name="PART_Header"
                                                                          Grid.Column="1"
                                                                          ContentSource="Header"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                Margin="16,0,0,0"
                                                                HorizontalAlignment="Stretch"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger SourceName="HeaderBorder" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#2C3138"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#303944"/>
                                                    <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#4FC1FF"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ContextMenu>
                            <ContextMenu Background="#28313B"
                                         Foreground="#D6DEE7"
                                         BorderBrush="#37414D">
                                <MenuItem Header="Delete Entity"
                                          Foreground="#E06C75"
                                          Click="DeleteEntityContextMenu_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>

                        <!-- Designer preview items; runtime import replaces these. -->
                        
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="#37414D"/>

            <!-- Keep scene tools adjacent to the native viewport. -->
            <DockPanel Grid.Column="2" Background="#151619">
                <Border DockPanel.Dock="Top" Background="#24272B" Height="35" Padding="12,0"
                        BorderBrush="#393D42" BorderThickness="0,0,0,1">
                    <TextBlock Text="Scene" Style="{StaticResource PanelHeading}"/>
                </Border>
                <local:engineViewport x:Name="ViewportControl"/>
            </DockPanel>

            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Stretch"
                          Background="#37414D"/>

            <!-- Inspector and viewport settings -->
            <Border Grid.Column="4"
                    Background="#202225"
                    BorderBrush="#37414D"
                    BorderThickness="1,0,0,0"
                    Padding="8,0">
                <TabControl x:Name="RightPanelTabs"
                            Background="#202225"
                            SelectionChanged="RightPanelTabs_SelectionChanged"
                            BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="#99A7B7"/>
                            <Setter Property="Background" Value="#1D232B"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="Transparent"
                                                BorderThickness="0,0,0,2"
                                                Padding="12,9"
                                                Margin="0,0,4,10">
                                            <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Foreground" Value="#F2F6FA"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4C9EFF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem x:Name="InspectorTab" Header="Inspector" IsSelected="True">
                <Grid>
                    <TextBlock Text="Select an object in the hierarchy or viewport."
                               d:Visibility="Collapsed"
                               Foreground="#ADB3BB"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=HierarchyTree, Path=SelectedItem}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  d:Visibility="Visible">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=HierarchyTree, Path=SelectedItem}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <!-- Show for an entity root or one of its components. -->
                            <StackPanel x:Name="EntityInspectorSection"
                                        Visibility="Collapsed"
                                        Margin="0,8,0,12">
                                <TextBlock Text="Entity"
                                           FontWeight="SemiBold"
                                           Foreground="#4C9EFF"
                                           Margin="0,0,0,6"/>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Name" Width="108" VerticalAlignment="Center" Foreground="#B8BDC4"/>
                                    <TextBox x:Name="EntityNameTextBox" Text="{Binding ElementName=HierarchyTree, Path=SelectedItem.Header, Mode=OneWay}" TextChanged="EntityNameTextBox_TextChanged"/>
                                </DockPanel>
                                <TextBlock Text="Components"
                                           Foreground="#99A7B7"
                                           FontSize="11"
                                           Margin="0,0,0,5"/>
                                <WrapPanel>
                                    <Button x:Name="AddModelButton"
                                            Content="+ Model"
                                            Click="AddModelButton_Click"
                                            Margin="0,0,6,6"
                                            Padding="8,4"
                                            Background="#28313B"
                                            Foreground="#D6DEE7"
                                            BorderBrush="#37414D"/>
                                    <Button x:Name="AddCameraButton"
                                            Content="+ Camera"
                                            Click="AddCameraButton_Click"
                                            Margin="0,0,6,6"
                                            Padding="8,4"
                                            Background="#28313B"
                                            Foreground="#D6DEE7"
                                            BorderBrush="#37414D"/>
                                    <Button x:Name="AddLightButton"
                                            Content="+ Light"
                                            Click="AddLightButton_Click"
                                            Margin="0,0,0,6"
                                            Padding="8,4"
                                            Background="#28313B"
                                            Foreground="#D6DEE7"
                                            BorderBrush="#37414D"/>
                                </WrapPanel>
                                <Separator Background="#333333"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Camera component properties for the selected camera. -->
                            <StackPanel x:Name="CameraInspectorSection"
                                        Visibility="Collapsed"
                                        d:Visibility="Visible"
                                        Margin="0,8,0,12">
                                <TextBlock Text="Camera"
                                           FontWeight="SemiBold"
                                           Foreground="#4C9EFF"
                                           Margin="0,0,0,8"/>

                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Field of view (°)" Width="108" VerticalAlignment="Center" Foreground="#B8BDC4"/>
                                    <TextBox x:Name="CameraFovTextBox" Text="45.0" TextChanged="CameraFovTextBox_TextChanged"/>
                                </DockPanel>

                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Movement Speed" Width="108" VerticalAlignment="Center" Foreground="#B8BDC4"/>
                                    <TextBox x:Name="CameraSpeedTextBox" Text="50.0" TextChanged="CameraSpeedTextBox_TextChanged"/>
                                </DockPanel>

                                <Expander Header="Advanced"
                                          Foreground="#D6DEE7">
                                    <StackPanel Margin="10,8,0,0">
                                        <DockPanel Margin="0,2">
                                    <TextBlock Text="Near Plane" Width="108" VerticalAlignment="Center" Foreground="#B8BDC4"/>
                                    <TextBox x:Name="CameraNearTextBox" Text="0.05" TextChanged="CameraNearTextBox_TextChanged"/>
                                </DockPanel>

                                        <DockPanel Margin="0,2">
                                    <TextBlock Text="Far Plane" Width="108" VerticalAlignment="Center" Foreground="#B8BDC4"/>
                                    <TextBox x:Name="CameraFarTextBox" Text="1000.0" TextChanged="CameraFarTextBox_TextChanged"/>
                                </DockPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <!-- Light component properties for the selected light. -->
                            <StackPanel x:Name="LightInspectorSection"
                                        Visibility="Collapsed"
                                        d:Visibility="Visible"
                                        Margin="0,8,0,12">
                                <TextBlock Text="Light" FontWeight="SemiBold" Foreground="#4C9EFF" Margin="0,0,0,8"/>
                                <TextBlock Text="Type" Foreground="#99A7B7" FontSize="11" Margin="0,0,0,3"/>
                                <ComboBox x:Name="LightTypeComboBox"
                                          Style="{StaticResource LightTypeSelectorStyle}"
                                          ItemContainerStyle="{StaticResource LightTypeOptionStyle}"
                                          Margin="0,0,0,12" SelectionChanged="LightTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Directional" ToolTip="Light from a fixed direction"/>
                                    <ComboBoxItem Content="Point" ToolTip="Light radiating from a position"/>
                                    <ComboBoxItem Content="Spot" ToolTip="Light within a cone"/>
                                </ComboBox>
                                <TextBlock Text="Light Color" Foreground="#99A7B7" FontSize="11" Margin="0,0,0,3"/>
                                <DockPanel Margin="0,0,0,10">
                                    <Button x:Name="LightColorButton" Content="Choose Color" Padding="8,4" Background="#28313B" Foreground="#D6DEE7" BorderBrush="#37414D" Click="LightColorButton_Click"/>
                                    <Border x:Name="LightColorPreview" BorderBrush="#777777" BorderThickness="1" Width="28" Height="24" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                </DockPanel>
                                <TextBlock Text="Intensity" Foreground="#99A7B7" FontSize="11" Margin="0,0,0,3"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="LightIntensityValueText" Text="{Binding ElementName=LightIntensitySlider, Path=Value, StringFormat={}{0:F3}}" Foreground="#D6DEE7" VerticalAlignment="Center" Margin="8,0,0,0" DockPanel.Dock="Right"/>
                                    <Slider x:Name="LightIntensitySlider" Minimum="0" Maximum="10" TickFrequency="1.0" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="LightIntensitySlider_ValueChanged"/>
                                </DockPanel>
                                <TextBlock Text="Direction" Foreground="#99A7B7" FontSize="11" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="LightDirectionXTextBox" Grid.Column="0" Margin="0,0,3,0" TextChanged="LightDirectionXTextBox_TextChanged"/><TextBox x:Name="LightDirectionYTextBox" Grid.Column="1" Margin="2,0" TextChanged="LightDirectionYTextBox_TextChanged"/><TextBox x:Name="LightDirectionZTextBox" Grid.Column="2" Margin="3,0,0,0" TextChanged="LightDirectionZTextBox_TextChanged"/>
                                </Grid>
                                <TextBlock Text="Position" Foreground="#99A7B7" FontSize="11" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="LightPositionXTextBox" Grid.Column="0" Margin="0,0,3,0" TextChanged="LightPositionXTextBox_TextChanged"/><TextBox x:Name="LightPositionYTextBox" Grid.Column="1" Margin="2,0" TextChanged="LightPositionYTextBox_TextChanged"/><TextBox x:Name="LightPositionZTextBox" Grid.Column="2" Margin="3,0,0,0" TextChanged="LightPositionZTextBox_TextChanged"/>
                                </Grid>
                                <Expander Header="Advanced" Foreground="#D6DEE7">
                                    <StackPanel Margin="10,8,0,0">
                                        <DockPanel Margin="0,2">
                                    <TextBlock Text="Ambient strength" Width="108" VerticalAlignment="Center" Foreground="#B8BDC4"/>
                                    <TextBox x:Name="LightAmbientStrengthTextBox" TextChanged="LightAmbientStrengthTextBox_TextChanged"/>
                                </DockPanel>
                                        <DockPanel Margin="0,2">
                                    <TextBlock Text="Diffuse strength" Width="108" VerticalAlignment="Center" Foreground="#B8BDC4"/>
                                    <TextBox x:Name="LightDiffuseStrengthTextBox" TextChanged="LightDiffuseStrengthTextBox_TextChanged"/>
                                </DockPanel>
                                        <DockPanel Margin="0,2">
                                    <TextBlock Text="Specular strength" Width="108" VerticalAlignment="Center" Foreground="#B8BDC4"/>
                                    <TextBox x:Name="LightSpecularStrengthTextBox" TextChanged="LightSpecularStrengthTextBox_TextChanged"/>
                                </DockPanel>
                                        <TextBlock Text="Spot Cutoff (degrees)" Foreground="#99A7B7" FontSize="11" Margin="0,0,0,3"/><TextBox x:Name="LightCutoffTextBox" Margin="0,0,0,8" TextChanged="LightCutoffTextBox_TextChanged"/>
                                        <TextBlock Text="Spot Outer Cutoff (degrees)" Foreground="#99A7B7" FontSize="11" Margin="0,0,0,3"/><TextBox x:Name="LightOuterCutoffTextBox" Margin="0,0,0,8" TextChanged="LightOuterCutoffTextBox_TextChanged"/>
                                        <TextBlock Text="Attenuation (constant, linear, quadratic)" Foreground="#99A7B7" FontSize="11" Margin="0,0,0,3"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="LightConstantTextBox" Grid.Column="0" Margin="0,0,3,0" TextChanged="LightConstantTextBox_TextChanged"/><TextBox x:Name="LightLinearTextBox" Grid.Column="1" Margin="2,0" TextChanged="LightLinearTextBox_TextChanged"/><TextBox x:Name="LightQuadraticTextBox" Grid.Column="2" Margin="3,0,0,0" TextChanged="LightQuadraticTextBox_TextChanged"/></Grid>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            <!-- Model and node details. -->
                            <StackPanel x:Name="ModelInspectorSection">

                            </StackPanel>

                            <!-- Shared by entity, model, model-node, and camera selection. -->
                            <StackPanel x:Name="TransformInspectorSection">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=EntityInspectorSection, Path=Visibility}"
                                                         Value="Visible">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=ModelInspectorSection, Path=Visibility}"
                                                         Value="Visible">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=CameraInspectorSection, Path=Visibility}" Value="Visible">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                            <!-- Numeric input style applies only to transform controls. -->
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <EventSetter Event="PreviewTextInput"
                                                     Handler="NumericTextBox_PreviewTextInput"/>
                                        <EventSetter Event="DataObject.Pasting"
                                                     Handler="NumericTextBox_Pasting"/>
                                    </Style>
                                </StackPanel.Resources>

                                <Expander Header="Transform" IsExpanded="True" Padding="6,4" Background="#282B2E"
                                          BorderBrush="#3A3C40" BorderThickness="0,1,0,1" Foreground="#E4E7EB">
                                    <StackPanel Margin="1,5,1,4">
                                <Grid Margin="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="X" Foreground="#EB9896" Margin="6,0"/>
                                    <TextBlock Grid.Column="2" Text="Y" Foreground="#A8C895" Margin="6,0"/>
                                    <TextBlock Grid.Column="3" Text="Z" Foreground="#90B9E5" Margin="6,0"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Position" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PositionXTextBox" Grid.Column="1" Margin="2,0" Padding="4,3"
                                             Text="0" ToolTip="Position X" AutomationProperties.Name="Position X"
                                             TextChanged="PositionXTextBox_TextChanged"/>
                                    <TextBox x:Name="PositionYTextBox" Grid.Column="2" Margin="2,0" Padding="4,3"
                                             Text="0" ToolTip="Position Y" AutomationProperties.Name="Position Y"
                                             TextChanged="PositionYTextBox_TextChanged"/>
                                    <TextBox x:Name="PositionZTextBox" Grid.Column="3" Margin="2,0" Padding="4,3"
                                             Text="0" ToolTip="Position Z" AutomationProperties.Name="Position Z"
                                             TextChanged="PositionZTextBox_TextChanged"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Rotation" VerticalAlignment="Center"/>
                                    <TextBox x:Name="RotationXTextBox" Grid.Column="1" Margin="2,0" Padding="4,3"
                                             Text="0" ToolTip="Rotation X" AutomationProperties.Name="Rotation X"
                                             TextChanged="RotationXTextBox_TextChanged"/>
                                    <TextBox x:Name="RotationYTextBox" Grid.Column="2" Margin="2,0" Padding="4,3"
                                             Text="0" ToolTip="Rotation Y" AutomationProperties.Name="Rotation Y"
                                             TextChanged="RotationYTextBox_TextChanged"/>
                                    <TextBox x:Name="RotationZTextBox" Grid.Column="3" Margin="2,0" Padding="4,3"
                                             Text="0" ToolTip="Rotation Z" AutomationProperties.Name="Rotation Z"
                                             TextChanged="RotationZTextBox_TextChanged"/>
                                </Grid>
                                <StackPanel x:Name="ScaleInspectorSection">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=CameraInspectorSection, Path=Visibility}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Scale" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ScaleXTextBox" Grid.Column="1" Margin="2,0" Padding="4,3"
                                             Text="1" ToolTip="Scale X" AutomationProperties.Name="Scale X"
                                             TextChanged="ScaleXTextBox_TextChanged"/>
                                    <TextBox x:Name="ScaleYTextBox" Grid.Column="2" Margin="2,0" Padding="4,3"
                                             Text="1" ToolTip="Scale Y" AutomationProperties.Name="Scale Y"
                                             TextChanged="ScaleYTextBox_TextChanged"/>
                                    <TextBox x:Name="ScaleZTextBox" Grid.Column="3" Margin="2,0" Padding="4,3"
                                             Text="1" ToolTip="Scale Z" AutomationProperties.Name="Scale Z"
                                             TextChanged="ScaleZTextBox_TextChanged"/>
                                </Grid>
                                    <CheckBox x:Name="UniformScaleCheckBox" Content="Uniform scale"
                                              Foreground="#C6CBD2" Margin="62,5,0,3"
                                              ToolTip="Scale all axes together while preserving their proportions"/>
                                </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="RenderModeInspectorSection"
                                        Visibility="{Binding ElementName=ModelInspectorSection, Path=Visibility}">

                            <Separator Background="#333333"
                                       Margin="0,8,0,12"/>

                            <!-- Placeholder render settings -->
                            <TextBlock Text="Render Mode"
                                       FontWeight="SemiBold"
                                       Foreground="#4C9EFF"
                                       Margin="0,0,0,6"/>

                            <CheckBox x:Name="WireframeCheckBox"
                                      Content="Wireframe Mode"
                                      Foreground="#D6DEE7"
                                      Margin="0,3"
                                      Click="WireframeMode_Click"/>
                            <CheckBox Content="Draw Normals"
                                      Foreground="#D6DEE7"
                                      Margin="0,3"/>
                            <CheckBox Content="Cast Shadows"
                                      IsChecked="True"
                                      Foreground="#D6DEE7"
                                      Margin="0,3"/>

                            </StackPanel>

                            <StackPanel x:Name="LightIntensityInspectorSection"
                                        Visibility="Collapsed"
                                        d:Visibility="Visible">
                                <Separator Background="#333333"
                                           Margin="0,8,0,12"/>
                                <TextBlock Text="Light Intensity"
                                           FontWeight="SemiBold"
                                           Foreground="#4C9EFF"
                                           Margin="0,0,0,6"/>
                                <Slider x:Name="LegacyLightIntensitySlider"
                                        Minimum="0"
                                        Maximum="10"
                                        Value="2.5"
                                        TickFrequency="0.5"
                                        IsSnapToTickEnabled="False"/>
                            </StackPanel>

                            <Separator Background="#333333"
                                       Margin="0,16,0,12"/>

                            <Button x:Name="btnDeleteSelection" Content="Delete Entity"
                                    Background="#302629"
                                    Foreground="#FF8888"
                                    BorderBrush="#604448"
                                    Padding="6,4"
                                    HorizontalAlignment="Right"
                                    Click="Button_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                    </TabItem>

                    <TabItem x:Name="ViewportTab" Header="Viewport">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <EventSetter Event="PreviewTextInput" Handler="ViewportCameraTextBox_PreviewTextInput"/>
                                        <EventSetter Event="DataObject.Pasting" Handler="ViewportCameraTextBox_Pasting"/>
                                        <EventSetter Event="TextChanged" Handler="ViewportCameraTextBox_TextChanged"/>
                                        <EventSetter Event="LostFocus" Handler="ViewportCameraTextBox_LostFocus"/>
                                        <EventSetter Event="PreviewKeyDown" Handler="ViewportCameraTextBox_PreviewKeyDown"/>
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock Text="VIEW CAMERA"
                                           FontWeight="Bold"
                                           Foreground="#E8EDF3"
                                           FontSize="12"
                                           Margin="0,0,0,8"/>
                                <Button x:Name="UseSelectedCameraButton"
                                        Content="Use Selected Camera"
                                        Click="UseSelectedCameraButton_Click"
                                        Padding="8,5"
                                        Margin="0,0,0,6"
                                        Background="#28313B"
                                        Foreground="#D6DEE7"
                                        BorderBrush="#37414D"/>
                                <Button x:Name="UseEditorCameraButton"
                                        Content="Use Editor Camera"
                                        Click="UseEditorCameraButton_Click"
                                        Padding="8,5"
                                        Background="#28313B"
                                        Foreground="#D6DEE7"
                                        BorderBrush="#37414D"/>
                                <Separator Background="#37414D"
                                           Margin="0,16,0,16"/>
                                <TextBlock Text="EDITOR CAMERA"
                                           FontWeight="Bold"
                                           Foreground="#E8EDF3"
                                           FontSize="12"
                                           Margin="0,0,0,4"/>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Movement Speed" Width="108" VerticalAlignment="Center" Foreground="#B8BDC4"/>
                                    <TextBox x:Name="EditorCameraSpeedTextBox" Text="10.0"/>
                                </DockPanel>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Field of view (°)" Width="108" VerticalAlignment="Center" Foreground="#B8BDC4"/>
                                    <TextBox x:Name="EditorCameraFovTextBox" Text="45.0"/>
                                </DockPanel>

                                <Expander Header="Advanced"
                                          Foreground="#D6DEE7"
                                          Margin="0,18,0,0">
                                    <StackPanel Margin="10,8,0,0">
                                        <DockPanel Margin="0,2">
                                    <TextBlock Text="Near Plane" Width="108" VerticalAlignment="Center" Foreground="#B8BDC4"/>
                                    <TextBox x:Name="EditorCameraNearTextBox" Text="0.1"/>
                                </DockPanel>
                                        <DockPanel Margin="0,2">
                                    <TextBlock Text="Far Plane" Width="108" VerticalAlignment="Center" Foreground="#B8BDC4"/>
                                    <TextBox x:Name="EditorCameraFarTextBox" Text="20000.0"/>
                                </DockPanel>
                                    </StackPanel>
                                </Expander>
                                <Separator Background="#37414D"
                                           Margin="0,16,0,16"/>
                                <TextBlock Text="RENDERING"
                                           FontWeight="Bold"
                                           Foreground="#E8EDF3"
                                           FontSize="12"
                                           Margin="0,0,0,8"/>
                                <CheckBox x:Name="ViewportVSyncCheckBox"
                                          Click="ViewportVSyncCheckBox_Click"
                                          Content="V-Sync"
                                          IsChecked="True"
                                          Foreground="#D6DEE7"
                                          Cursor="Hand"
                                          ToolTip="Synchronize viewport frames with the display refresh rate">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Border x:Name="VSyncRow"
                                                    Background="#28313B"
                                                    BorderBrush="#37414D"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="10,8">
                                                <DockPanel LastChildFill="True">
                                                    <Border x:Name="SwitchTrack"
                                                            DockPanel.Dock="Right"
                                                            Width="34" Height="18"
                                                            Background="#39434E"
                                                            BorderBrush="#52606D"
                                                            BorderThickness="1"
                                                            CornerRadius="9">
                                                        <Ellipse x:Name="SwitchThumb"
                                                                 Width="12" Height="12"
                                                                 Fill="#D6DEE7"
                                                                 HorizontalAlignment="Left"
                                                                 Margin="2,0,0,0"/>
                                                    </Border>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="SwitchTrack" Property="Background" Value="#4C9EFF"/>
                                                    <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#4C9EFF"/>
                                                    <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="VSyncRow" Property="BorderBrush" Value="#657586"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="VSyncRow" Property="BorderBrush" Value="#95C4F2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        </DockPanel>
        <Border Grid.Row="1" Background="#24272B" BorderBrush="#393D42"
                BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ImportStatusText" Text="Ready" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="EngineFpsText" Grid.Column="1" Text="Engine FPS: —" Margin="12,0"/>
                <TextBlock x:Name="EngineFrameTimeText" Grid.Column="2" Text="Frame time: —" Foreground="#B7BCC2"/>
            </Grid>
        </Border>
    </Grid>
</Window>
