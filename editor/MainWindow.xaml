<Window x:Class="rendererUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rendererUI"
        mc:Ignorable="d"
        Title="Engine Editor"
        Height="720"
        Width="1280"
        MinHeight="640"
        MinWidth="1000"
        Background="#1E1E1E"
        Foreground="#CCCCCC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
                Background="#2D2D30"
                BorderBrush="#3E3E42"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button x:Name="ImportAssetButton"
                        Content="📁 Import Asset..."
                        Click="onImportAsset_Click"
                        Margin="3"
                        Padding="10,2"
                        Background="#2D2D30"
                        Foreground="#CCCCCC"
                        BorderBrush="#3E3E42"/>

                <Separator Background="#3E3E42" Margin="6,4"/>

                <TextBlock Text="Target"
                           Foreground="#888888"
                           VerticalAlignment="Center"
                           Margin="3,0,5,0"/>

                <RadioButton x:Name="ModelTargetRadio"
                             Content="Model"
                             GroupName="TransformTarget"
                             IsChecked="True"
                             Foreground="#CCCCCC"
                             VerticalAlignment="Center"
                             Margin="3,0"
                             ToolTip="Apply transforms to the whole model"/>

                <RadioButton x:Name="NodeTargetRadio"
                             Content="Node"
                             GroupName="TransformTarget"
                             Foreground="#CCCCCC"
                             VerticalAlignment="Center"
                             Margin="3,0"
                             ToolTip="Apply transforms to the selected node"/>

                <Separator Background="#3E3E42" Margin="6,4"/>

                <TextBlock Text="Tool"
                           Foreground="#888888"
                           VerticalAlignment="Center"
                           Margin="3,0,5,0"/>

                <RadioButton x:Name="SelectModeRadio"
                             Content="Select"
                             GroupName="TransformTool"
                             IsChecked="True"
                             Foreground="#CCCCCC"
                             VerticalAlignment="Center"
                             Margin="3,0"
                             ToolTip="Select objects"/>

                <RadioButton x:Name="MoveModeRadio"
                             Content="Move"
                             GroupName="TransformTool"
                             Foreground="#CCCCCC"
                             VerticalAlignment="Center"
                             Margin="3,0"
                             ToolTip="Move the current target"/>

                <RadioButton x:Name="RotateModeRadio"
                             Content="Rotate"
                             GroupName="TransformTool"
                             Foreground="#CCCCCC"
                             VerticalAlignment="Center"
                             Margin="3,0"
                             ToolTip="Rotate the current target"/>

                <RadioButton x:Name="ScaleModeRadio"
                             Content="Scale"
                             GroupName="TransformTool"
                             Foreground="#CCCCCC"
                             VerticalAlignment="Center"
                             Margin="3,0"
                             ToolTip="Scale the current target"/>
            </StackPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- Hierarchy -->
            <Border Grid.Column="0"
                    Background="#252526"
                    BorderBrush="#3E3E42"
                    BorderThickness="0,0,1,0"
                    Padding="10">
                <DockPanel>
                    <TextBlock Text="SCENE HIERARCHY"
                               FontWeight="Bold"
                               Foreground="#D4D4D4"
                               FontSize="12"
                               Margin="2,2,0,10"
                               DockPanel.Dock="Top"/>

                    <TreeView x:Name="HierarchyTree"
                              SelectedItemChanged="HierarchyTree_SelectedItemChanged"
                              PreviewMouseLeftButtonUp="HierarchyTree_PreviewMouseLeftButtonUp"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#E6E6E6"
                              FontSize="12"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Resources>
                            <Style TargetType="{x:Type ScrollBar}">
                                <Setter Property="Width" Value="12"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                                            <Grid Background="Transparent" Width="12">
                                                <Track x:Name="PART_Track"
                                                       IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                                      Opacity="0"
                                                                      IsTabStop="False"
                                                                      Focusable="False"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                                    <Border x:Name="ThumbBorder"
                                                                            Background="#515861"
                                                                            CornerRadius="6"
                                                                            Margin="2,3"/>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#737D88"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsDragging" Value="True">
                                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="#AAB4C0"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                                      Opacity="0"
                                                                      IsTabStop="False"
                                                                      Focusable="False"/>
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="{x:Type ToggleButton}">
                                <Setter Property="Content" Value="›"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#AAB4C0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="⌄"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="MinHeight" Value="25"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Foreground" Value="#E6E6E6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HeaderTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border x:Name="HeaderBorder"
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        Margin="2,1,3,1"
                                                        CornerRadius="8"
                                                        HorizontalAlignment="Stretch">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="Expander"
                                                                      Grid.Column="0"
                                                                      Width="16"
                                                                      Height="25"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                                        <ContentPresenter x:Name="PART_Header"
                                                                          Grid.Column="1"
                                                                          ContentSource="Header"
                                                                          HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                Margin="16,0,0,0"
                                                                HorizontalAlignment="Stretch"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger SourceName="HeaderBorder" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#2C3138"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#303944"/>
                                                    <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#4FC1FF"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ContextMenu>
                            <ContextMenu Background="#2D2D30"
                                         Foreground="#CCCCCC"
                                         BorderBrush="#3E3E42">
                                <MenuItem Header="Delete Entity"
                                          Foreground="#E06C75"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>

                        <!-- Designer preview items; runtime import replaces these. -->
                        
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="#3E3E42"/>

            <!-- Viewport and Console -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#111111"
                        BorderBrush="#3E3E42"
                        BorderThickness="1">
                    <local:engineViewport x:Name="ViewportControl"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>
                </Border>

                <GridSplitter Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              Background="#3E3E42"/>

                <Border Grid.Row="2"
                        Background="#252526"
                        BorderBrush="#3E3E42"
                        BorderThickness="0,1,0,0">
                    <DockPanel Margin="10,8">
                        <TextBlock Text="CONSOLE / LOGS"
                                   DockPanel.Dock="Top"
                                   Foreground="#D4D4D4"
                                   FontSize="11"
                                   FontWeight="Bold"/>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock x:Name="ImportStatusText"
                                       Text="Ready"
                                       Foreground="#888888"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="EngineFpsText"
                                       Text="Engine FPS: waiting for render stats..."
                                       Foreground="#D4D4D4"
                                       FontSize="12"/>
                            <TextBlock x:Name="EngineFrameTimeText"
                                       Text="Frame time: -- ms"
                                       Margin="0,3,0,0"
                                       Foreground="#888888"
                                       FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Stretch"
                          Background="#3E3E42"/>

            <!-- Inspector -->
            <Border Grid.Column="4"
                    Background="#252526"
                    BorderBrush="#3E3E42"
                    BorderThickness="1,0,0,0"
                    Padding="12">
                <Grid>
                    <TextBlock Text="No object selected."
                               d:Visibility="Collapsed"
                               Foreground="#666666"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=HierarchyTree, Path=SelectedItem}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  d:Visibility="Visible">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=HierarchyTree, Path=SelectedItem}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <TextBlock Text="INSPECTOR"
                                       FontWeight="Bold"
                                       Foreground="#D4D4D4"
                                       Margin="0,0,0,4"
                                       FontSize="12"/>

                            <TextBlock Text="Selected object"
                                       Foreground="#888888"
                                       FontSize="11"
                                       Margin="0,0,0,5"/>

                            <!-- Selected node name -->
                            <TextBox x:Name="SelectedNodeNameTextBox"
                                     Text="{Binding ElementName=HierarchyTree, Path=SelectedItem.Header, Mode=OneWay}"
                                     d:Text="Selected Node"
                                     IsReadOnly="False"
                                     Background="#1E1E1E"
                                     Foreground="#CCCCCC"
                                     BorderBrush="#3E3E42"
                                     Padding="6,4"
                                     Margin="0,0,0,12"
                                     ToolTip="Rename the selected model or node"
                                     TextChanged="SelectedNodeNameTextBox_TextChanged"/>

                            <Separator Background="#333333"
                                       Margin="0,0,0,12"/>

                            <!-- Numeric input style applies only to transform controls. -->
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style TargetType="{x:Type TextBox}">
                                        <EventSetter Event="PreviewTextInput"
                                                     Handler="NumericTextBox_PreviewTextInput"/>
                                        <EventSetter Event="DataObject.Pasting"
                                                     Handler="NumericTextBox_Pasting"/>
                                    </Style>
                                </StackPanel.Resources>

                                <TextBlock Text="Transform"
                                           FontWeight="SemiBold"
                                           Foreground="#4EC9B0"
                                           Margin="0,0,0,6"/>

                                <!-- Position -->
                                <TextBlock Text="Position"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Margin="0,2"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <DockPanel Grid.Column="0" Margin="0,0,2,0">
                                        <TextBlock Text="X"
                                                   Foreground="#E06C75"
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBox x:Name="PositionXTextBox"
                                                 Text="0"
                                                 IsReadOnly="False"
                                                 Background="#1E1E1E"
                                                 Foreground="#CCCCCC"
                                                 BorderBrush="#3E3E42"
                                                 Padding="2"
                                                 TextChanged="PositionXTextBox_TextChanged"
                                                 Width="73"/>
                                    </DockPanel>

                                    <DockPanel Grid.Column="1" Margin="2,0,2,0">
                                        <TextBlock Text="Y"
                                                   Foreground="#98C379"
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBox x:Name="PositionYTextBox"
                                                 Text="0"
                                                 IsReadOnly="False"
                                                 Background="#1E1E1E"
                                                 Foreground="#CCCCCC"
                                                 BorderBrush="#3E3E42"
                                                 Padding="2"
                                                 TextChanged="PositionYTextBox_TextChanged"/>
                                    </DockPanel>

                                    <DockPanel Grid.Column="2" Margin="2,0,0,0">
                                        <TextBlock Text="Z"
                                                   Foreground="#61AFEF"
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBox x:Name="PositionZTextBox"
                                                 Text="0"
                                                 IsReadOnly="False"
                                                 Background="#1E1E1E"
                                                 Foreground="#CCCCCC"
                                                 BorderBrush="#3E3E42"
                                                 Padding="2"
                                                 Width="74"
                                                 TextChanged="PositionZTextBox_TextChanged"/>
                                    </DockPanel>
                                </Grid>

                                <!-- Rotation -->
                                <TextBlock Text="Rotation"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Margin="0,2"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <DockPanel Grid.Column="0" Margin="0,0,2,0">
                                        <TextBlock Text="X"
                                                   Foreground="#E06C75"
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBox x:Name="RotationXTextBox"
                                                 Text="0"
                                                 IsReadOnly="False"
                                                 Background="#1E1E1E"
                                                 Foreground="#CCCCCC"
                                                 BorderBrush="#3E3E42"
                                                 Padding="2"
                                                 TextChanged="RotationXTextBox_TextChanged"/>
                                    </DockPanel>

                                    <DockPanel Grid.Column="1" Margin="2,0,2,0">
                                        <TextBlock Text="Y"
                                                   Foreground="#98C379"
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBox x:Name="RotationYTextBox"
                                                 Text="0"
                                                 IsReadOnly="False"
                                                 Background="#1E1E1E"
                                                 Foreground="#CCCCCC"
                                                 BorderBrush="#3E3E42"
                                                 Padding="2"
                                                 Width="72"
                                                 TextChanged="RotationYTextBox_TextChanged"/>
                                    </DockPanel>

                                    <DockPanel Grid.Column="2" Margin="2,0,0,0">
                                        <TextBlock Text="Z"
                                                   Foreground="#61AFEF"
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBox x:Name="RotationZTextBox"
                                                 Text="0"
                                                 IsReadOnly="False"
                                                 Background="#1E1E1E"
                                                 Foreground="#CCCCCC"
                                                 BorderBrush="#3E3E42"
                                                 Padding="2"
                                                 Width="74"
                                                 TextChanged="RotationZTextBox_TextChanged"/>
                                    </DockPanel>
                                </Grid>

                                <!-- Scale -->
                                <TextBlock Text="Scale"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Margin="0,2"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <DockPanel Grid.Column="0" Margin="0,0,2,0">
                                        <TextBlock Text="X"
                                                   Foreground="#E06C75"
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBox x:Name="ScaleXTextBox"
                                                 Text="1"
                                                 IsReadOnly="False"
                                                 Background="#1E1E1E"
                                                 Foreground="#CCCCCC"
                                                 BorderBrush="#3E3E42"
                                                 Padding="2"
                                                 TextChanged="ScaleXTextBox_TextChanged"/>
                                    </DockPanel>

                                    <DockPanel Grid.Column="1" Margin="2,0,2,0">
                                        <TextBlock Text="Y"
                                                   Foreground="#98C379"
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBox x:Name="ScaleYTextBox"
                                                 Text="1"
                                                 IsReadOnly="False"
                                                 Background="#1E1E1E"
                                                 Foreground="#CCCCCC"
                                                 BorderBrush="#3E3E42"
                                                 Padding="2"
                                                 TextChanged="ScaleYTextBox_TextChanged"/>
                                    </DockPanel>

                                    <DockPanel Grid.Column="2" Margin="2,0,0,0">
                                        <TextBlock Text="Z"
                                                   Foreground="#61AFEF"
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBox x:Name="ScaleZTextBox"
                                                 Text="1"
                                                 IsReadOnly="False"
                                                 Background="#1E1E1E"
                                                 Foreground="#CCCCCC"
                                                 BorderBrush="#3E3E42"
                                                 Padding="2"
                                                 TextChanged="ScaleZTextBox_TextChanged"/>
                                    </DockPanel>
                                </Grid>
                            </StackPanel>

                            <Separator Background="#333333"
                                       Margin="0,8,0,12"/>

                            <!-- Placeholder render settings -->
                            <TextBlock Text="Render Mode"
                                       FontWeight="SemiBold"
                                       Foreground="#4EC9B0"
                                       Margin="0,0,0,6"/>

                            <CheckBox x:Name="WireframeCheckBox"
                                      Content="Wireframe Mode"
                                      Foreground="#CCCCCC"
                                      Margin="0,3"
                                      Click="WireframeMode_Click"/>
                            <CheckBox Content="Draw Normals"
                                      Foreground="#CCCCCC"
                                      Margin="0,3"/>
                            <CheckBox Content="Cast Shadows"
                                      IsChecked="True"
                                      Foreground="#CCCCCC"
                                      Margin="0,3"/>

                            <TextBlock Text="Light Intensity"
                                       Foreground="#AAAAAA"
                                       FontSize="11"
                                       Margin="0,8,0,2"/>
                            <Slider Minimum="0"
                                    Maximum="10"
                                    Value="2.5"
                                    TickFrequency="0.5"
                                    IsSnapToTickEnabled="False"/>

                            <Separator Background="#333333"
                                       Margin="0,16,0,12"/>

                            <Button Content="Delete Entity"
                                    Background="#5A1D1D"
                                    Foreground="#FF8888"
                                    BorderBrush="#8B0000"
                                    Padding="6,4"
                                    HorizontalAlignment="Stretch"
                                    Click="Button_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2"
                   Background="#007ACC"
                   Foreground="White"
                   Padding="6,1">
            <TextBlock Text="Ready"/>
        </StatusBar>
    </Grid>
</Window>
