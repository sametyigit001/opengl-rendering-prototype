<Window x:Class="rendererUI.LightColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Light Color" Width="336" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" Background="{StaticResource EditorSurface}"
        Foreground="{StaticResource EditorText}">
    <StackPanel Margin="18">
        <TextBlock Text="LIGHT COLOR" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal">
            <Grid x:Name="ColorArea" Width="240" Height="240" Background="Red"
                  MouseLeftButtonDown="ColorArea_MouseLeftButtonDown"
                  MouseMove="ColorArea_MouseMove"
                  MouseLeftButtonUp="ColorArea_MouseLeftButtonUp">
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="Black" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="ColorMarker" Width="12" Height="12"
                             Stroke="White" StrokeThickness="2" Fill="Transparent"/>
                </Canvas>
            </Grid>
            <Grid x:Name="HueArea" Width="28" Height="240" Margin="12,0,0,0" Background="Transparent"
                  MouseLeftButtonDown="HueArea_MouseLeftButtonDown"
                  MouseMove="HueArea_MouseMove"
                  MouseLeftButtonUp="HueArea_MouseLeftButtonUp">
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Red" Offset="0"/>
                            <GradientStop Color="Yellow" Offset="0.1667"/>
                            <GradientStop Color="Lime" Offset="0.3333"/>
                            <GradientStop Color="Cyan" Offset="0.5"/>
                            <GradientStop Color="Blue" Offset="0.6667"/>
                            <GradientStop Color="Magenta" Offset="0.8333"/>
                            <GradientStop Color="Red" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Rectangle x:Name="HueMarker" Width="28" Height="4"
                               Stroke="White" StrokeThickness="1" Fill="Transparent"/>
                </Canvas>
            </Grid>
        </StackPanel>
        <DockPanel Margin="0,14,0,0">
            <Border x:Name="SelectedPreview" Width="32" Height="28"
                    BorderBrush="#777777" BorderThickness="1" DockPanel.Dock="Left"/>
            <TextBlock x:Name="HexText" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="70" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Apply" Width="70" Background="{StaticResource EditorAccent}"
                    Foreground="#0D1724" BorderBrush="{StaticResource EditorAccent}"
                    Click="Apply_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
